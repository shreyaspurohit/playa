# === EVENT DATA — deliberately not committed ===
# Encrypted annual API snapshots are restored from GitHub Releases in CI.
# Local copies remain outside git history.
data/api/
# Reviewed API-year Food exclusions are ID-only decisions and stay tracked.
# Do not add a wildcard that ignores data/food-exclusions-api-*.txt.
# Official annual GIS caches + normalized offline map payloads.
data/gis/

# === GENERATED SITE — not committed either ===
# site/index.html contains the (encrypted) fetched payload. site/sw.js
# is regenerated each build to tie cache keys to the build version.
# Both built on the runner, uploaded via actions/upload-pages-artifact,
# deployed from there. site/CNAME, site/robots.txt, site/.nojekyll,
# site/manifest.webmanifest, site/icon.svg stay committed —
# they're config + PWA shell assets, not data.
site/index.html
site/privacy.html
site/sw.js
site/version.txt
site/burn-key.json
# Code-split semantic-search chunk (ADR 21). Built on the runner from
# client/dist and uploaded with the Pages artifact; never committed.
site/semantic-backend.js

# === BRC map data from /update-map skill — never commit ===
# The skill downloads measurements PDF / city plan PDF / GeoJSON /
# KMZ to /tmp/brc-<YEAR>/, not the repo. These rules are
# belt-and-suspenders: if anything binary-map-shaped leaks into the
# tree (wrong cwd, a manual download), git won't pick it up.
*.pdf
*.kml
*.kmz
*.mbtiles
*.geojson
*.shp
*.dbf

# === Client toolchain ===
# node_modules is restored by `npm ci` in CI; bundle.js is regenerated
# on every build. Keep only source + config in git.
client/node_modules/
client/dist/
# Local Chrome-for-Testing install used by `make review-mobile`.
chrome-headless-shell/

# === Python build artifacts (from `pip install -e ./backend`) ===
backend/src/*.egg-info/
backend/build/
*.egg-info/

# === Standard ignores ===
__pycache__/
*.pyc
.DS_Store

# Vim/editor swap files
*.swp
*.swo
*.swn
*~

# Local overrides. Put real passwords and API keys in env or repo secrets,
# not in the tree.
.env
.env.local

# Derived semantic-search vectors (embedding cache + output) — never committed
data/embeddings/
site/embeddings.json
site/embeddings-*.json
